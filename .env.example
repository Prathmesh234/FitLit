# FitLit configuration — copy to `.env` and fill in.
# `.env` is gitignored; never commit real tokens.

# Every model-backed workflow uses this one headless harness. Supported values:
# claude, codex, copilot, opencode. Claude Code is the default.
HARNESS=claude

# --- Google Health API auth --------------------------------------------------
# Pick ONE of the two approaches below.
#
# (A) OAuth refresh (recommended for any unattended / 24-7 run). The service
#     mints fresh access tokens from a long-lived refresh token automatically.
#     1. Set the client id + secret from your Google Cloud OAuth client.
#     2. Run `uv run python -m fitlit.auth login` and follow the prompts to
#        capture the refresh token, then paste it below.
GOOGLE_HEALTH_CLIENT_ID=your-oauth-client-id
GOOGLE_HEALTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_HEALTH_REFRESH_TOKEN=your-refresh-token
#
# (B) Static access token — quick one-off testing only. Expires in ~1h and does
#     NOT self-renew; the service 401s after that. Leave unset if using (A).
# GOOGLE_HEALTH_ACCESS_TOKEN=paste-access-token-here

# 'me' resolves to the token's own user. Or set an explicit user id.
GOOGLE_HEALTH_USER=me

# Redirect URI used by `fitlit.auth login` — must match a URI registered on the
# OAuth client if it's a "Web application" type (Desktop-app clients don't need it).
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/callback

# --- Gmail notification service ---------------------------------------------
# Reuses the OAuth client ID/secret above, but requires a separate send-only
# refresh token. Enable Gmail API, then run:
#   uv run python scripts/oauth_capture.py --gmail
GMAIL_REFRESH_TOKEN=your-gmail-send-refresh-token
FITLIT_GMAIL_TO=you@gmail.com
# FITLIT_GMAIL_FROM_NAME=FitLit
# FITLIT_GMAIL_MORNING_FALLBACK_HOUR=12
# FITLIT_GMAIL_EVENING_FILL_HOUR=20
# Weekly catalog: Sunday at 8 PM Pacific.
# FITLIT_GMAIL_WEEKLY_REPORT_HOUR=20
# FITLIT_GMAIL_WEEKLY_RETRY_UNTIL_HOUR=12

# Optional email-to-FitLit command inbox. This uses a second, isolated
# gmail.readonly token; the existing token remains send-only.
#   uv run python scripts/oauth_capture.py --gmail-inbox
# GMAIL_INBOX_REFRESH_TOKEN=your-gmail-readonly-refresh-token
# FITLIT_GMAIL_INBOX_ENABLED=false
# FITLIT_GMAIL_INBOX_SUBJECT_PREFIX=FitLit Ask:
# FITLIT_GMAIL_INBOX_DAILY_MAX=20
# FITLIT_GMAIL_INBOX_BATCH_MAX=5
# Gmail-only near-real-time listener; default and minimum 5 seconds.
# FITLIT_GMAIL_INBOX_POLL_SECONDS=5
# Retryable commands back off exponentially from this delay.
# FITLIT_GMAIL_INBOX_RETRY_BASE_SECONDS=30
#
# The first successfully processed FitLit Ask thread becomes the only inbox
# chain polled afterward. The latest five messages in that exact chain are
# supplied in-memory to the selected isolated headless provider; older messages
# and unrelated mailbox mail are not fetched as model context or stored.
FITLIT_EMAIL_AGENT_CLAUDE_MODEL=claude-sonnet-5
FITLIT_EMAIL_AGENT_REASONING_EFFORT=high
FITLIT_EMAIL_AGENT_CONTEXT_MESSAGES=5
# FITLIT_EMAIL_AGENT_MAX_TURNS=10
# FITLIT_EMAIL_AGENT_MAX_SUBAGENTS=2
# FITLIT_EMAIL_AGENT_TIMEOUT_SECONDS=180
# FITLIT_EMAIL_AGENT_MAX_ARTIFACTS=2
# FITLIT_EMAIL_AGENT_MAX_ATTACHMENT_BYTES=5000000
# Inherited Copilot ceiling: headless Copilot refuses a request file at or
# above 20,480 bytes, and the limit is kept as a shared cap so one composed
# request is valid on every harness. The composed request is adaptively
# narrowed (evidence tier first, then the oldest context turns) to stay under
# this budget; clamped to 4,000-20,479.
# FITLIT_EMAIL_AGENT_REQUEST_BUDGET_BYTES=18000
# Alternate harnesses, when installed and configured:
# FITLIT_EMAIL_AGENT_CODEX_MODEL=
# FITLIT_EMAIL_AGENT_COPILOT_MODEL=gpt-5.6-sol
# FITLIT_EMAIL_AGENT_OPENCODE_MODEL=
# Optional dollar ceiling per conversational run. Unset means uncapped, which
# is the default: Claude reports cost at list price even on a subscription
# session where no per-token charge is incurred, so a cap can abort a reply
# without preventing real spend. Set a positive amount only on API-key billing.
# FITLIT_EMAIL_AGENT_CLAUDE_MAX_BUDGET_USD=

# --- Optional private Telegram bot ------------------------------------------
# Create a bot with @BotFather and keep its token only in private .env. Run
# `uv run python -m fitlit.telegram_service pair` to bind one numeric user ID.
# The service uses outbound long polling, so no public webhook is required.
# FITLIT_TELEGRAM_ENABLED=false
# FITLIT_TELEGRAM_BOT_TOKEN=your-botfather-token
# FITLIT_TELEGRAM_TRUSTED_USER_ID=
# Telegram can use a model independently from the Gmail headless agent.
FITLIT_TELEGRAM_CLAUDE_MODEL=claude-sonnet-5
# FITLIT_TELEGRAM_CODEX_MODEL=
# FITLIT_TELEGRAM_COPILOT_MODEL=gpt-5.6-terra
# FITLIT_TELEGRAM_OPENCODE_MODEL=
# FITLIT_TELEGRAM_REASONING_EFFORT=high
# Complete active conversations are stored in an owner-only local SQLite file.
# /new archives the current indexed conversation without deleting it. Every
# harness can search archived turns through the read-only transcript-memory MCP
# tool when the active conversation refers to earlier context.
# FITLIT_TELEGRAM_BODY_MAX_CHARS=2000
# Outbound chunk budget, measured in UTF-16 code units like Telegram's own
# 4096 limit, so an astral emoji costs two units.
# FITLIT_TELEGRAM_MESSAGE_CHUNK_CHARS=4000
# A deterministic update that keeps failing locally is quarantined after this
# many attempts so it can never block every later message.
# FITLIT_TELEGRAM_POISON_ATTEMPTS=3
# This is the idle long-poll hold; updates return immediately when they arrive.
# FITLIT_TELEGRAM_POLL_TIMEOUT_SECONDS=5

# --- Optional proactive-report AI observations -------------------------------
# Disabled by default. The deterministic detector still controls what and when
# to send; the global HARNESS can only add schema-validated observations.
# FITLIT_AI_ENABLED=false
# FITLIT_AI_TIMEOUT_SECONDS=45
# FITLIT_AI_REASONING_EFFORT=medium
# FITLIT_AI_COPILOT_MODEL=
# FITLIT_AI_CODEX_MODEL=
# FITLIT_AI_CLAUDE_MODEL=
# FITLIT_AI_OPENCODE_MODEL=
# FITLIT_AI_CLAUDE_MAX_BUDGET_USD=

# --- Optional private coaching profile ---------------------------------------
# Keep real values only in .env. Leaving these blank disables the body model.
# FITLIT_BODY_FAT_ESTIMATE_PCT=
# FITLIT_TARGET_BODY_FAT_PCT=
# FITLIT_HEIGHT_M=
# FITLIT_GOAL_LABEL=personal health goal
# FITLIT_TRAINING_PRIORITIES=

# --- Optional overrides (sensible defaults already in config.py) -------------
# GOOGLE_HEALTH_BASE_URL=https://health.googleapis.com
# GOOGLE_HEALTH_PAGE_SIZE=100
# GOOGLE_HEALTH_TIMEOUT=30

# Rate limit: Google Health rejects with 429 past ~120 req/min/user; stay under.
# GOOGLE_HEALTH_RATE_LIMIT_PER_MIN=100

# How often the orchestrator wakes to dispatch due fetchers (seconds).
# FITLIT_TICK_SECONDS=10

# --- Server / container ------------------------------------------------------
# HTTP bind. Default is loopback-only; the container image overrides this
# internally and must be published only to host loopback or private ingress.
# HOST=127.0.0.1
# PORT=8000
# Run the API without the background scheduler (e.g. extra API-only replicas).
# FITLIT_RUN_SCHEDULER=true

# --- Persistence -------------------------------------------------------------
# Where SQLite DBs + scheduler state are written. Point at a mounted volume /
# Azure Files share in a container so data survives restarts.
# FITLIT_DATA_DIR=/app/data
# Set to DELETE when the data dir is an SMB/Azure Files share (WAL needs local
# disk or NFS). Leave as WAL on local/ephemeral disk.
# FITLIT_SQLITE_JOURNAL=WAL
